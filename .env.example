# 复制为 .env 后填写。留空的数据源会走演示数据。

# —— 搬瓦工 KiwiVM ——
# 控制面板左侧 API：VEID + Show API Key
BWH_VEID=
BWH_API_KEY=
# 一般不用改
BWH_API_BASE=https://api.64clouds.com/v1

# —— 3X-UI ——
# 面板地址，含自定义路径，不要末尾斜杠
# 例: http://127.0.0.1:2053   或  https://your.domain:2053/secret
XUI_BASE_URL=
# 推荐：面板 设置 → 安全 → API Token（3.x）
XUI_API_TOKEN=
# 没有 Token 就用账号密码登录
XUI_USERNAME=
XUI_PASSWORD=
# 自签证书时设为 0
XUI_VERIFY_SSL=1
# 若开启了两步验证
XUI_TWO_FACTOR=

# —— 本监控面板 ——
HOST=127.0.0.1
PORT=8787
# 留空则无需登录；填写后打开面板要输入这个密码
DASHBOARD_PASSWORD=
# 强制演示数据（调试用）
DEMO=0
